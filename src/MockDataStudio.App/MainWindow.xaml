<Window x:Class="MockDataStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MockDataStudio.App.Controls"
        Title="Mock Data Studio"
        Width="1600" Height="940" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra superior -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mock Data Studio" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <controls:SearchField Grid.Column="1" Placeholder="Pesquisar projetos, conexões, tabelas ou qualquer coisa..."
                                      ShowShortcut="True" MaxWidth="560" Margin="16,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Center" Width="520" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Margin="4,0" Width="36" Height="36">
                        <Button Style="{StaticResource GhostButton}" Width="36" Height="36" ToolTip="Notificações">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="16" />
                        </Button>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,6,6,0" IsHitTestVisible="False" />
                    </Grid>
                    <Button Style="{StaticResource GhostButton}" Width="36" Height="36" Margin="4,0" ToolTip="Ajuda">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="16" />
                    </Button>

                    <Border Margin="10,0,8,0" Padding="6,4,10,4" CornerRadius="8" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="JD" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="John Doe" VerticalAlignment="Center" Margin="8,0,6,0"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="6,0" />

                    <Button x:Name="MinButton" Style="{StaticResource GhostButton}" Width="44" Height="36"
                            Click="MinButton_Click" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource GhostButton}" Width="44" Height="36"
                            Click="MaxButton_Click" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Width="44" Height="36"
                            Click="CloseButton_Click" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navegação lateral -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Margin="10,14"
                     ItemContainerStyle="{StaticResource NavItemStyle}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Width="26" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Conteúdo -->
        <ContentControl x:Name="ContentHost" Grid.Row="1" Grid.Column="1" Margin="24,20,24,20" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
