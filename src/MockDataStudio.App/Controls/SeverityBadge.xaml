<UserControl x:Class="MockDataStudio.App.Controls.SeverityBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Icon" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="Label" FontWeight="Medium" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
