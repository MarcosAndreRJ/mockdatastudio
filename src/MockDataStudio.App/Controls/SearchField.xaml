<UserControl x:Class="MockDataStudio.App.Controls.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38">
    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0" />

            <Grid Grid.Column="1">
                <TextBox x:Name="Input" Style="{StaticResource SearchBox}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                           IsHitTestVisible="False" Margin="4,0,0,0" x:Name="Hint" />
            </Grid>

            <Border Grid.Column="2" Margin="8,0,0,0" Padding="6,2" CornerRadius="5"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding ShowShortcut, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ctrl + K" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
