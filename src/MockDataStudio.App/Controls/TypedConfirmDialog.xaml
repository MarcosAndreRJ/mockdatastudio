<Window x:Class="MockDataStudio.App.Controls.TypedConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="InstructionText" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="Input" TextChanged="Input_TextChanged" Height="36" Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" IsCancel="True" MinWidth="110" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="110" IsEnabled="False" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
