<UserControl x:Class="MockDataStudio.App.Views.SqlResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <!-- DataContext: SqlResultsViewModel da aba selecionada do editor. -->
    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RowCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <controls:SearchField Placeholder="Search results..." Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="Filtrar resultados" />
                    <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0" Command="{Binding ExportCommand}"
                            ToolTip="Exportar as linhas exibidas (CSV ou JSON)" AutomationProperties.Name="Exportar resultados">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Text" Value="&#xE711;" />
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                </StackPanel>
            </DockPanel>

            <TabControl Style="{StaticResource UnderlineTabControl}" ItemContainerStyle="{StaticResource UnderlineTabItem}"
                        SelectedIndex="{Binding SelectedTabIndex}" Margin="10,0,10,0">
                <TabItem AutomationProperties.Name="Results">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Results" />
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" FontSize="12" Margin="0,6,0,6"
                              EnableColumnVirtualization="True" EnableRowVirtualization="True" AutomationProperties.Name="Grade de resultados" />
                </TabItem>
                <TabItem AutomationProperties.Name="Messages">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Messages" />
                        </StackPanel>
                    </TabItem.Header>
                    <TextBox Text="{Binding MessagesText, Mode=OneWay}" Style="{StaticResource ReadOnlyEditor}" TextWrapping="Wrap" Margin="0,6,0,6"
                             AutomationProperties.Name="Mensagens" />
                </TabItem>
                <TabItem AutomationProperties.Name="Query Plan">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Query Plan" />
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding PlanRows}" AutoGenerateColumns="True" IsReadOnly="True" FontSize="12" Margin="0,6,0,6"
                              AutomationProperties.Name="Plano de execução" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>

</UserControl>
