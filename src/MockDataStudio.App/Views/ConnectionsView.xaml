<UserControl x:Class="MockDataStudio.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho e ações -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Connections" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Gerencie conexões com bancos de dados, ambientes e configurações de conectividade."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" Command="{Binding NewConnectionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Connection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0" Command="{Binding RefreshAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh All" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <UniformGrid.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Margin" Value="0,0,14,0" />
                </Style>
            </UniformGrid.Resources>

            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource TealSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource TealBrush}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Total Connections" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding TotalConnectionsCount}" FontSize="26" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="{Binding OnlineConnectionsCount, Mode=OneWay}" /> online • <Run Text="{Binding OfflineConnectionsCount, Mode=OneWay}" /> offline
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource SuccessSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Online" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding OnlineConnectionsCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Testadas com sucesso" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource DangerSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE704;" Foreground="{StaticResource DangerBrush}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Offline" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding OfflineConnectionsCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Não testadas / Falhas" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource PurpleSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource PurpleBrush}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Environments" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding EnvironmentSummaryText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Ambientes detectados" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Conteúdo principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="410" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.55*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Conexões salvas -->
                <Border Style="{StaticResource Card}" Padding="16" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}" Width="32" Height="32" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center">
                                    <Run Text="Saved Connections (" /><Run Text="{Binding SavedConnections.Count, Mode=OneWay, FallbackValue=0}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:SearchField Placeholder="Search connections..." Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding SavedConnections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="1.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="24" Height="24" Margin="0,0,8,0">
                                                    <Image Source="{Binding Logo}" Stretch="Uniform" />
                                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="Auto" />
                                <DataGridTextColumn Header="Host / Path" Binding="{Binding HostPath}" Width="*" />
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
                                <DataGridTemplateColumn Header="Environment" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2" CornerRadius="10" Background="{Binding EnvBg}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Environment}" Foreground="{Binding EnvFg}" FontWeight="Medium" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Checked" Binding="{Binding LastChecked}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Saúde e histórico -->
                <Border Style="{StaticResource Card}" Padding="16" Grid.Row="2" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Connection Activity &amp; Test Results" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Testes recentes -->
                            <DockPanel>
                                <TextBlock Text="Recent Connection Tests" FontWeight="Medium" DockPanel.Dock="Top" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding RecentConnectionTests}" FontSize="11">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding When}" Width="Auto" />
                                        <DataGridTemplateColumn Header="Status" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,1" CornerRadius="8" Background="{Binding StatusBg}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontWeight="Medium" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="Auto" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Atividades recentes -->
                            <DockPanel Grid.Column="2">
                                <TextBlock Text="Audit Activity" FontWeight="Medium" DockPanel.Dock="Top" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding ConnectionActivities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="11" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Detalhes da conexão -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.Column="2" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Connection Details" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="32" Height="32"
                                Command="{Binding DeleteCommand}" ToolTip="Excluir Perfil">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource DangerBrush}" />
                        </Button>
                    </Grid>

                    <!-- Rodapé de Ações -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
                        <CheckBox Content="Read-only mode (preferência salva)" IsChecked="{Binding FormIsReadOnly, Mode=TwoWay}" FontSize="12" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Credenciais são criptografadas via DPAPI (Windows)." Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>

                        <!-- Mensagem de resultado / Status do teste -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                Visibility="{Binding TestResultMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TestResultMessage}" Foreground="{Binding TestStatusColor}" TextWrapping="Wrap" FontSize="11" />
                        </Border>

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <!-- Botão Test Connection -->
                            <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,0"
                                    Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsNotTesting}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Test Connection" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Botão Save Changes -->
                            <Button Style="{StaticResource PrimaryButton}" Height="38"
                                    Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotTesting}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Save Changes" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource SecondaryButton}" Height="38"
                                    Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding IsNotTesting}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open in Explorer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0"
                                    Command="{Binding CancelTestCommand}" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cancel Test" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,18,0">
                        <StackPanel>
                            <!-- Cabeçalho da conexão -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" Margin="0,0,12,0">
                                    <Image Source="{Binding EngineLogo}" Stretch="Uniform" />
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EngineLogo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormSubtitle}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="8,3" CornerRadius="12" Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding TestStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TestStatusText}" Foreground="{Binding TestStatusColor}" FontWeight="Medium" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Campos -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Name -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,4"><Run Text="Connection Name" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <!-- Provider -->
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Provider" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableEngines}" SelectedItem="{Binding FormEngine, Mode=TwoWay}" Height="36" />
                                </StackPanel>

                                <!-- Host & Port -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding RequiresHostPort, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,4"><Run Text="Host" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                                    <TextBox Text="{Binding FormHost, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" Visibility="{Binding RequiresHostPort, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,4"><Run Text="Port" /><Run Text=" *" Foreground="{StaticResource DangerBrush}" /></TextBlock>
                                    <TextBox Text="{Binding FormPort, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <!-- Database / Path -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource LabelText}" Text="Database / Path" />
                                        <TextBlock Style="{StaticResource LabelText}" Text=" *" Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding RequiresDatabase, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Servidores: combo editável com os bancos listados após testar a conexão -->
                                        <ComboBox IsEditable="True" Height="36" ItemsSource="{Binding AvailableDatabases}"
                                                  Text="{Binding FormDatabase, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding IsNetworkDatabase, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBox Text="{Binding FormDatabase, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                                 Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Height="36" Padding="10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding BrowseSqliteFileCommand}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Username -->
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12" Visibility="{Binding RequiresCredentials, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Username" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <!-- Password -->
                                <StackPanel Grid.Row="3" Margin="0,0,0,12" Visibility="{Binding RequiresCredentials, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Password" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6,36,6" />
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                    <CheckBox Content="Sempre solicitar senha" IsChecked="{Binding FormPromptPassword, Mode=TwoWay}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- SSL Mode -->
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12" Visibility="{Binding HasSslMode, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="SSL Mode" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableSslModes}" SelectedItem="{Binding FormSslMode, Mode=TwoWay}" Height="36" />
                                </StackPanel>

                                <!-- Connection Timeout -->
                                <StackPanel Grid.Row="4" Margin="0,0,0,12">
                                    <TextBlock Text="Connection Timeout (seconds)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormTimeoutSec, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                                </StackPanel>

                                <!-- Environment -->
                                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Environment" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableEnvironments}" SelectedItem="{Binding FormEnvironment, Mode=TwoWay}" Height="36" />
                                </StackPanel>

                                <!-- Notes -->
                                <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                    <TextBlock Text="Notes" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,8"
                                             Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
