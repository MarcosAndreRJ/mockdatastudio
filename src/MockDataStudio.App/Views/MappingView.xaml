<UserControl x:Class="MockDataStudio.App.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls"
             xmlns:vm="clr-namespace:MockDataStudio.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho, trilha e ações -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Field Mapping" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Mapeie campos das tabelas para templates de geração e defina como os dados fictícios serão criados."
                           Style="{StaticResource PageSubtitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Projeto" Style="{StaticResource MutedText}" />
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding SelectedTable.Name}" FontWeight="Medium" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Width="38" Height="38" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Command="{Binding UndoCommand}" ToolTip="{Binding UndoLabel}" AutomationProperties.Name="Desfazer" />
                <Button Style="{StaticResource GhostButton}" Width="38" Height="38" Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Command="{Binding RedoCommand}" ToolTip="Refazer" AutomationProperties.Name="Refazer" />
                <Button Style="{StaticResource PrimaryButton}" Height="38" Margin="8,0,0,0" Padding="14,0" Command="{Binding AutoMapCommand}" AutomationProperties.Name="Mapear automaticamente">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Auto Map" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="38" Margin="10,0,0,0" Padding="14,0" Cursor="Hand" Background="{StaticResource WarningSoftBrush}"
                        BorderBrush="#FCD34D" BorderThickness="1" Foreground="{StaticResource WarningBrush}" FontWeight="Medium"
                        Command="{Binding ReviewCommand}" AutomationProperties.Name="Revisar pendências">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Review Pending" VerticalAlignment="Center" />
                        <Border Background="{StaticResource WarningBrush}" CornerRadius="9" MinWidth="18" Height="18" Margin="8,0,-4,0" Padding="4,0">
                            <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Height="38" Margin="10,0,0,0" Padding="14,0" Cursor="Hand" Background="{StaticResource SuccessSoftBrush}"
                        BorderBrush="#86EFAC" BorderThickness="1" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"
                        Command="{Binding ValidateCommand}" AutomationProperties.Name="Validar mapeamentos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Validate" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0" Command="{Binding SaveCommand}" AutomationProperties.Name="Salvar projeto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save Project" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Tabelas -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TablesTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Tabelas">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding FieldInfo}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{Binding StatusBg}">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Campos da tabela -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.Column="2" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="190" />
                            <ColumnDefinition Width="10" /><ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FieldsTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <controls:SearchField Grid.Column="2" Placeholder="Buscar campos..." Text="{Binding FieldSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="4" Height="38" ItemsSource="{x:Static vm:MappingViewModel.StatusFilters}"
                                  SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Filtro de status" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" FontSize="12" Margin="0"
                              IsReadOnly="True" SelectionMode="Single" AutomationProperties.Name="Campos da tabela">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Field" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                            <DataGridTextColumn Header="Constraints" Binding="{Binding Constraints}" Width="Auto" />
                            <DataGridTextColumn Header="Suggested" Binding="{Binding SuggestedTemplate}" Width="140" />
                            <DataGridTextColumn Header="Generator" Binding="{Binding Generator}" Width="*" />
                            <DataGridTemplateColumn Header="Confidence" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,2" CornerRadius="10" Background="{Binding ConfidenceBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Confidence}" Foreground="{Binding ConfidenceFg}" FontWeight="Medium" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,2" CornerRadius="10" Background="{Binding StatusBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontWeight="Medium" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Detalhes do campo -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.Column="4" ClipToBounds="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Field Details" Style="{StaticResource SectionTitle}" Margin="16,14,16,10" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Padding="8,2" CornerRadius="10" Background="{Binding DetailStatusBg}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailStatus}" Foreground="{Binding DetailStatusFg}" FontWeight="Medium" FontSize="11" />
                                </Border>
                            </Grid>

                            <!-- Sugestões -->
                            <TextBlock Text="Sugestões" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" BorderThickness="0" Background="Transparent"
                                     MaxHeight="170" Margin="0,0,0,10" AutomationProperties.Name="Sugestões do campo">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedText}">
                                                    <Run Text="{Binding Generator, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Confidence, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Score}" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Content="Aceitar"
                                                    Command="{Binding DataContext.AcceptCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="Aceitar sugestão" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Editor de gerador (montado pelos descriptors) -->
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Generator Configuration" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="Generator Type" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <ComboBox Height="36" ItemsSource="{Binding GeneratorChoices}" SelectedItem="{Binding SelectedGenerator}" Margin="0,0,0,10"
                                              AutomationProperties.Name="Tipo de gerador" />

                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AcceptsReturn="{Binding IsMultiline}"
                                                             TextWrapping="Wrap" AutomationProperties.Name="{Binding Name}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <ComboBox Height="36" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Name}"
                                                              Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Style="{StaticResource PrimaryButton}" Height="34" Content="Aplicar gerador" HorizontalAlignment="Left" Padding="14,0"
                                            Command="{Binding ApplyGeneratorCommand}" AutomationProperties.Name="Aplicar gerador" />
                                    <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Opções do vínculo -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Taxa de NULL (0 a 1)" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                                    <TextBox Height="36" Text="{Binding NullRateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Taxa de nulos" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox Content="Valores únicos" IsChecked="{Binding IsUnique}" Margin="0,0,0,8" AutomationProperties.Name="Valores únicos" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Nota" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <TextBox Height="36" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Nota do vínculo" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Content="Salvar opções"
                                        Command="{Binding ApplyOptionsCommand}" AutomationProperties.Name="Salvar opções" />
                                <Button Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="8,0,0,0" Content="Limpar vínculo"
                                        Command="{Binding ClearCommand}" AutomationProperties.Name="Limpar vínculo" />
                            </StackPanel>

                            <TextBlock Text="Aliases Matched" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding MatchedAliases}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" FontWeight="Medium" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Scoring Reasons" Style="{StaticResource LabelText}" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding ScoringReasons}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Preview Generated Values" FontWeight="SemiBold" />
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="Re-generate" Foreground="{StaticResource AccentBrush}"
                                        Command="{Binding RegenerateCommand}" AutomationProperties.Name="Gerar novas amostras" />
                            </Grid>
                            <TextBlock Text="{Binding PreviewError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding PreviewValues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinWidth="40" Height="30" Margin="0,0,6,6" Padding="8,0">
                                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
