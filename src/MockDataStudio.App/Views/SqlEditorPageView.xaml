<UserControl x:Class="MockDataStudio.App.Views.SqlEditorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MockDataStudio.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:SqlEditorView DataContext="{Binding Workspace}" />
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />
        <views:SqlResultsView Grid.Row="2" DataContext="{Binding Workspace.SelectedTab.Results}" />

        <!-- Barra de estado da aba selecionada (C5.4, docs/23 §5.4): a borda superior de 3 px segue o ambiente; Production em vermelho. -->
        <Border Grid.Row="3" Padding="10,5" BorderThickness="0,3,0,0" DataContext="{Binding Workspace.SelectedTab}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#6B7280" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusBar.IsProduction}" Value="True">
                            <Setter Property="BorderBrush" Value="#DC2626" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusBar.Environment}" Value="Unknown">
                            <Setter Property="BorderBrush" Value="#D97706" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="#B45309"
                           Text="{Binding StatusBar.Warning}" Margin="12,0,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Text="{Binding StatusBar.ConnectionName, FallbackValue='Sem conexão', TargetNullValue='Sem conexão'}" />
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="{Binding StatusBar.EngineName}" />
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="{Binding StatusBar.Database}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                               Foreground="#B45309" Text="{Binding StatusBar.Environment}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusBar.IsProduction}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,0" Text="{Binding StatusBar.ReadOnlyLabel}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
