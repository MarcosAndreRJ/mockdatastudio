<UserControl x:Class="MockDataStudio.App.Views.SqlEditorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MockDataStudio.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:SqlEditorView DataContext="{Binding Editor}" />
        <views:SqlResultsView Grid.Row="2" DataContext="{Binding Results}" />
    </Grid>
</UserControl>
