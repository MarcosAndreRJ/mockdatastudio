<UserControl x:Class="MockDataStudio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MockDataStudio.App.Samples">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Workspace Overview" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Gerencie suas conexões, projetos e fluxos de geração de dados fictícios."
                       Style="{StaticResource PageSubtitle}" Margin="0,4,0,20" />

            <!-- Indicadores -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="0,0,14,0" />
                    </Style>
                </UniformGrid.Resources>

                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource TealSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Foreground="{StaticResource TealBrush}" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Active Connections" Style="{StaticResource LabelText}" />
                            <TextBlock Text="4" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ +1" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                                <TextBlock Text="3 online • 1 offline" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" />
                    </Grid>
                </Border>

                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource SuccessSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A1;" Foreground="{StaticResource SuccessBrush}" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Saved Projects" Style="{StaticResource LabelText}" />
                            <TextBlock Text="12" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ +3" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                                <TextBlock Text="Updated this week" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" />
                    </Grid>
                </Border>

                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Foreground="{StaticResource AccentBrush}" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Templates" Style="{StaticResource LabelText}" />
                            <TextBlock Text="8" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ +2" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                                <TextBlock Text="Ready to use" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" />
                    </Grid>
                </Border>

                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource OrangeSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="{StaticResource OrangeBrush}" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Recent Generations" Style="{StaticResource LabelText}" />
                            <TextBlock Text="25" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↑ +12" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" />
                                <TextBlock Text="Last 7 days" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Projetos recentes e ações rápidas -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Recent Projects" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="View all" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{x:Static s:SampleData.RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="62">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{Binding TintBg}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                       Foreground="{Binding Tint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                                            <TextBlock Text="{Binding Engine}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                                            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Updated}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <Border CornerRadius="10" Padding="14" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="New Connection" FontWeight="Medium" />
                                    <TextBlock Text="Connect to a database" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="10" Padding="14" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Import Digest" FontWeight="Medium" />
                                    <TextBlock Text="Analyze database schema" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="10" Padding="14" Background="{StaticResource PurpleSoftBrush}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PurpleBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="Open Project" FontWeight="Medium" />
                                    <TextBlock Text="Browse and open a project" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="10" Padding="14" Background="{StaticResource OrangeSoftBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="New Generation" FontWeight="Medium" />
                                    <TextBlock Text="Generate mock data" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Conexões e atividade recente -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Connections" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="Manage all" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{x:Static s:SampleData.Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="8" Background="{Binding TintBg}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                                   Foreground="{Binding Tint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Online}" Value="False">
                                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="62" /><ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="View all" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{x:Static s:SampleData.RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
