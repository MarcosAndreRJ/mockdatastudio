<UserControl x:Class="MockDataStudio.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho e ações -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Template Catalog" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Consulte, edite e importe os templates de geração de dados do catálogo local."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Command="{Binding RefreshCommand}" AutomationProperties.Name="Atualizar catálogo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Lista de templates -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Templates" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <controls:SearchField DockPanel.Dock="Top" Placeholder="Buscar templates..." Margin="0,0,0,10"
                                          Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista de templates">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{Binding TintBg}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Tint}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detalhes -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tipo" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding KindText}" TextWrapping="Wrap" />
                                <TextBlock Text="Tipo lógico" Style="{StaticResource LabelText}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding LogicalTypeText}" FontWeight="Medium" />
                                <TextBlock Text="Valores" Style="{StaticResource LabelText}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding ValueCountText}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="Origem" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding PackText}" TextWrapping="Wrap" />
                                <TextBlock Text="Tags" Style="{StaticResource LabelText}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding TagsText}" TextWrapping="Wrap" />
                                <TextBlock Text="Hash do conteúdo" Style="{StaticResource LabelText}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding HashText}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Campos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Fields}" FontSize="12" IsReadOnly="True" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Campo" Binding="{Binding FieldCode}" Width="*" />
                                    <DataGridTextColumn Header="Tipo lógico" Binding="{Binding LogicalType}" Width="Auto" />
                                    <DataGridTextColumn Header="Tam. máx." Binding="{Binding MaxLength}" Width="Auto" />
                                    <DataGridTextColumn Header="Obrigatório" Binding="{Binding Required}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Aliases" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Aliases}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding}" FontWeight="Medium" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Edição de template escalar (S07/S08, C8a.1). Embutidos são somente leitura. -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,14">
                        <StackPanel>
                            <TextBlock Text="Editar template" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Valores e aliases: um por linha. Templates embutidos não podem ser alterados."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Código" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Código do template" />
                            <TextBlock Text="Nome" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Nome do template" />
                            <TextBlock Text="Descrição" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Descrição do template" />
                            <TextBlock Text="Tipo lógico (string, integer, decimal, date…)" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormLogicalType, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Tipo lógico" />
                            <TextBlock Text="Valores" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormValues, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Valores do template" />
                            <TextBlock Text="Aliases" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding FormAliases, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"
                                     VerticalScrollBarVisibility="Auto" Margin="0,2,0,6" Padding="6,4" AutomationProperties.Name="Aliases do template" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding NewTemplateCommand}" Content="Novo" />
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding LoadTemplateCommand}" Content="Carregar selecionado" />
                                <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding SaveTemplateCommand}" Content="Salvar" />
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding CloneTemplateCommand}" Content="Copiar selecionado com o código do campo" />
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding DeleteTemplateCommand}" Content="Excluir selecionado" />
                            </WrapPanel>
                            <TextBlock Text="{Binding FormStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Importação por script SQL ou pack JSON (S09, C8a.2 e C8a.3). -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Importar templates" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Copie as instruções, cole-as numa IA e cole o script gerado aqui. A análise não altera o catálogo; só a importação altera."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox Content="É um pack JSON (formato de pack-core-ptbr.json)" IsChecked="{Binding ImportIsPackJson}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="140"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6,4" AutomationProperties.Name="Script ou pack a importar" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding CopyInstructionsCommand}" Content="Copiar instruções para IA" />
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding AnalyzeImportCommand}" Content="Analisar" />
                                <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding MergeImportCommand}" Content="Importar" />
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding DiscardImportCommand}" Content="Descartar análise" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Valores de exemplo -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Valores de exemplo" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="Primeiros valores em ordem do catálogo." Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding SampleValues}" BorderThickness="0" Background="Transparent" IsHitTestVisible="False" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" Padding="0,3" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
