<UserControl x:Class="MockDataStudio.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MockDataStudio.App.Resources"
             xmlns:tpl="clr-namespace:MockDataStudio.App.Views.Templates">

    <!-- Tela Templates (TC-102): cabeçalho e quatro abas. A seleção e a busca ficam no ViewModel e sobrevivem à troca de aba. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:TemplatesText.Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Static res:TemplatesText.Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" AutomationProperties.Name="{x:Static res:TemplatesText.RefreshAuto}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static res:TemplatesText.Refresh}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource UnderlineTabControl}" ItemContainerStyle="{StaticResource UnderlineTabItem}"
                    Padding="0,14,0,0" Foreground="{StaticResource TextPrimaryBrush}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Static res:TemplatesText.TabsAuto}">
            <TabItem Header="{x:Static res:TemplatesText.TabTemplates}" AutomationProperties.Name="{x:Static res:TemplatesText.TabTemplatesAuto}">
                <tpl:TemplatesTab />
            </TabItem>
            <TabItem Header="{x:Static res:TemplatesText.TabImportExport}" AutomationProperties.Name="{x:Static res:TemplatesText.TabImportExportAuto}">
                <tpl:ImportExportTab DataContext="{Binding ImportExport}" />
            </TabItem>
            <TabItem Header="{x:Static res:TemplatesText.TabPresets}" AutomationProperties.Name="{x:Static res:TemplatesText.TabPresetsAuto}">
                <tpl:PresetsTab DataContext="{Binding Presets}" />
            </TabItem>
            <TabItem Header="{x:Static res:TemplatesText.TabRules}" AutomationProperties.Name="{x:Static res:TemplatesText.TabRulesAuto}">
                <tpl:LearnedRulesTab DataContext="{Binding LearnedRules}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
