<UserControl x:Class="MockDataStudio.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MockDataStudio.App.Samples"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho e ações -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Template Catalog" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Gerencie templates de geração de dados para registros realistas e consistentes."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Template" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import SQL" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="New Dataset" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Export" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Lista de templates -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Templates" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:SearchField DockPanel.Dock="Top" Placeholder="Search templates..." Margin="0,0,0,12" />

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Categories" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" Height="32" Padding="10,0" CornerRadius="8" Width="150" HorizontalAlignment="Right"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <TextBlock Text="All Categories" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{x:Static s:SampleData.TemplateList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="10" Padding="8" Margin="0,0,0,4" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{Binding TintBg}">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Tint}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Detalhes do template -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource DangerSoftBrush}" Margin="0,0,14,0">
                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CEP" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Brazilian postal code (8 digits)" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Border Grid.Column="2" Padding="10,4" CornerRadius="12" Background="{StaticResource SuccessSoftBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Active" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Width="34" Height="34" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource TabText}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,4,-1">
                                <TextBlock Text="Overview" Foreground="{StaticResource AccentBrush}" FontWeight="Medium" />
                            </Border>
                            <Border Style="{StaticResource TabText}" Margin="0,0,4,-1"><TextBlock Text="Aliases" Foreground="{StaticResource TextSecondaryBrush}" /></Border>
                            <Border Style="{StaticResource TabText}" Margin="0,0,4,-1"><TextBlock Text="Sample Values" Foreground="{StaticResource TextSecondaryBrush}" /></Border>
                            <Border Style="{StaticResource TabText}" Margin="0,0,4,-1"><TextBlock Text="Generators" Foreground="{StaticResource TextSecondaryBrush}" /></Border>
                            <Border Style="{StaticResource TabText}" Margin="0,0,4,-1"><TextBlock Text="Usage" Foreground="{StaticResource TextSecondaryBrush}" /></Border>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Description" Style="{StaticResource SectionTitle}" FontSize="14" />
                                </StackPanel>
                                <TextBlock Text="Gera CEPs brasileiros válidos no formato NNNNN-NNN, representando o código postal usado pelos Correios no Brasil."
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="20" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="2">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TealBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Logical Type" Style="{StaticResource SectionTitle}" FontSize="14" />
                                </StackPanel>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="String" Foreground="{StaticResource AccentTextBrush}" FontWeight="Medium" />
                                </Border>
                                <TextBlock Text="Usage Count" Style="{StaticResource LabelText}" Margin="0,14,0,0" />
                                <TextBlock Text="8,742" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="↑ +12% · last 30 days" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Validation Rule" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,10" />
                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <TextBlock Text="^\d{5}-?\d{3}$" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="4" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Must contain 8 digits, optionally with a hyphen." Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="Generator Mode" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,10" />
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="Regex / Mask" Foreground="{StaticResource AccentTextBrush}" FontWeight="Medium" />
                                </Border>
                                <TextBlock Text="Generates values using a regular expression mask." Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Alias" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Aliases" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel>
                                <ItemsControl ItemsSource="{x:Static s:SampleData.CepAliases}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontWeight="Medium" FontSize="12" />
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Generate New" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Sample Values" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{x:Static s:SampleData.CepValuesLeft}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" />
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{x:Static s:SampleData.CepValuesRight}" Grid.Column="2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" />
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Pré-visualização do dataset e geradores -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dataset Preview" Style="{StaticResource SectionTitle}" FontSize="14" />
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Field Name" Style="{StaticResource MutedText}" Margin="0,6" />
                                <TextBlock Grid.Column="1" Text="cep" Margin="0,6" FontWeight="Medium" />

                                <TextBlock Grid.Row="1" Text="Logical Type" Style="{StaticResource MutedText}" Margin="0,6" />
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2" Margin="0,6" HorizontalAlignment="Left">
                                    <TextBlock Text="String" Foreground="{StaticResource AccentTextBrush}" />
                                </Border>

                                <TextBlock Grid.Row="2" Text="Format" Style="{StaticResource MutedText}" Margin="0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="NNNNN-NNN" FontFamily="Consolas" Margin="0,6" />

                                <TextBlock Grid.Row="3" Text="Nullable" Style="{StaticResource MutedText}" Margin="0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Yes" Margin="0,6" />

                                <TextBlock Grid.Row="4" Text="Unique" Style="{StaticResource MutedText}" Margin="0,6" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="No" Margin="0,6" />

                                <TextBlock Grid.Row="5" Text="Example" Style="{StaticResource MutedText}" Margin="0,6" />
                                <Border Grid.Row="5" Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="8,4" Margin="0,4" HorizontalAlignment="Left">
                                    <TextBlock Text="01001-000" FontFamily="Consolas" />
                                </Border>

                                <TextBlock Grid.Row="6" Text="Description" Style="{StaticResource MutedText}" Margin="0,6" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Brazilian postal code (CEP)" Margin="0,6" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Generator" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Linked Generators" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Regex / Mask" FontWeight="Medium" />
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="Primary" Foreground="{StaticResource AccentTextBrush}" FontSize="11" FontWeight="Medium" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Pattern: \d{5}-\d{3}" Style="{StaticResource MonoText}" Margin="0,2,0,0" />
                                    <TextBlock Text="Generates random valid CEPs using a regular expression." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource OrangeSoftBrush}">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="RandomList" FontWeight="Medium" />
                                    <TextBlock Text="Use a curated list of real CEPs" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Generate from a predefined list of valid postal codes." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource TealSoftBrush}">
                                    <TextBlock Text="#" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Sequence" FontWeight="Medium" />
                                    <TextBlock Text="Sequential CEP generation" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="Generate sequential CEPs starting from a base value." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
