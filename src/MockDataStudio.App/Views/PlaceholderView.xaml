<UserControl x:Class="MockDataStudio.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" />
            <TextBlock Text="Tela sem mockup nesta etapa. Será criada quando o mockup for fornecido."
                       Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
