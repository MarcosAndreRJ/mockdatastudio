<UserControl x:Class="MockDataStudio.App.Views.Templates.ImportExportTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MockDataStudio.App.Resources">

    <!-- Aba Importar/Exportar (TC-102). DataContext: TemplateImportExportViewModel. A análise não altera o catálogo; só a importação altera. -->
    <Grid TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{x:Static res:TemplatesText.ImportTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Static res:TemplatesText.ImportHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostButton}" Padding="10,2" Margin="0,0,8,6" Command="{Binding UseScriptExampleCommand}"
                                Content="{x:Static res:TemplatesText.ImportExampleScript}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportExampleScript}" />
                        <Button Style="{StaticResource GhostButton}" Padding="10,2" Margin="0,0,8,6" Command="{Binding UsePackExampleCommand}"
                                Content="{x:Static res:TemplatesText.ImportExamplePack}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportExamplePack}" />
                    </WrapPanel>
                    <CheckBox Content="{x:Static res:TemplatesText.ImportIsPack}" IsChecked="{Binding ImportIsPackJson}" Margin="0,0,0,6"
                              AutomationProperties.Name="{x:Static res:TemplatesText.ImportIsPack}" />
                    <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="220"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="6,4"
                             AutomationProperties.Name="{x:Static res:TemplatesText.ImportTextAuto}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding CopyInstructionsCommand}"
                                Content="{x:Static res:TemplatesText.ImportCopy}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportCopy}" />
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding AnalyzeImportCommand}"
                                Content="{x:Static res:TemplatesText.ImportAnalyze}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportAnalyze}" />
                        <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding MergeImportCommand}"
                                Content="{x:Static res:TemplatesText.ImportMerge}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportMerge}" />
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,6" Command="{Binding DiscardImportCommand}"
                                Content="{x:Static res:TemplatesText.ImportDiscard}" AutomationProperties.Name="{x:Static res:TemplatesText.ImportDiscard}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{x:Static res:TemplatesText.ExportTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBox Text="{Binding PackExportCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="6,4"
                         AutomationProperties.Name="{x:Static res:TemplatesText.ExportCodeAuto}" />
                <TextBox Text="{Binding PackExportName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="6,4"
                         AutomationProperties.Name="{x:Static res:TemplatesText.ExportNameAuto}" />
                <Button Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" HorizontalAlignment="Left" Command="{Binding ExportPackCommand}"
                        Content="{x:Static res:TemplatesText.ExportButton}" AutomationProperties.Name="{x:Static res:TemplatesText.ExportButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
