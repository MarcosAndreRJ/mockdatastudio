<UserControl x:Class="MockDataStudio.App.Views.Templates.LearnedRulesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls"
             xmlns:res="clr-namespace:MockDataStudio.App.Resources">

    <!-- Aba Regras aprendidas (FR-064). DataContext: LearnedRulesViewModel. -->
    <Border Style="{StaticResource Card}" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:TemplatesText.RulesTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:TemplatesText.RulesHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
            <controls:StatePanel DockPanel.Dock="Top" State="{Binding State}" Message="{Binding StatusMessage}"
                                 RetryCommand="{Binding RefreshCommand}" RetryText="{x:Static res:TemplatesText.Retry}" />
            <ItemsControl ItemsSource="{Binding Rules}" AutomationProperties.Name="{x:Static res:TemplatesText.RulesListAuto}"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Column, Mode=OneWay}" FontFamily="Consolas" />
                                <Run Text="→" />
                                <Run Text="{Binding Target, Mode=OneWay}" FontWeight="Medium" />
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{x:Static res:TemplatesText.RuleForget}" Padding="8,2"
                                    AutomationProperties.Name="{x:Static res:TemplatesText.RuleForgetAuto}"
                                    Command="{Binding DataContext.ForgetRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
