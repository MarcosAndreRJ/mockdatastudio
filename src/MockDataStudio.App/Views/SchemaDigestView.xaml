<UserControl x:Class="MockDataStudio.App.Views.SchemaDigestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="320" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho e ações -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Schema Digest" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Crie e explore uma representação compacta da estrutura do seu banco de dados."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Extract Digest" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Export JSON" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Compare Versions" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="38" Margin="10,0,0,0" Padding="14,0" Cursor="Hand" Background="{StaticResource SuccessSoftBrush}"
                        BorderThickness="0" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Validate" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Linha superior: estrutura, navegador e JSON -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Estrutura do banco -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Database Structure" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Overview of extracted schema objects" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsControl ItemsSource="{Binding DigestStats}" Grid.ColumnSpan="3" Grid.RowSpan="5">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Bg}" CornerRadius="10" Padding="10,8" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Fg}" />
                                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DigestInfo}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Medium" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Navegador do digest -->
            <Border Style="{StaticResource Card}" Padding="16" Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PurpleSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Digest Browser" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Explore database objects and their structure" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:SearchField Placeholder="Search tables, columns, or objects..." />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Width="38" Height="38" Padding="0"
                                Content="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Grid>

                    <TreeView x:Name="DigestTreeView" ItemsSource="{Binding DigestTree}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Prévia JSON -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.Column="4" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,16,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource TealSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="JSON Preview" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Digest representation for the selected object" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Width="34" Height="34" Padding="0" Margin="0,0,8,0"
                                Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <Border Grid.Column="3" Height="34" Padding="10,0" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="JSON" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBox Style="{StaticResource ReadOnlyEditor}" Text="{Binding DigestJson}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Linha inferior: relacionamentos e mudanças -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Relacionamentos -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource TealSoftBrush}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Schema Relationships" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Table relationships for selected object (pedido)" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Selected" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                            <Ellipse Width="9" Height="9" Fill="#93C5FD" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Related" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                            <Ellipse Width="9" Height="9" Fill="#CBD5E1" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Other" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </DockPanel>

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Canvas Width="600" Height="200">
                            <!-- Linhas -->
                            <Line X1="325" Y1="46" X2="325" Y2="82" Stroke="#94A3B8" StrokeThickness="1.5" />
                            <Line X1="250" Y1="100" X2="170" Y2="100" Stroke="#94A3B8" StrokeThickness="1.5" />
                            <Line X1="400" Y1="100" X2="470" Y2="100" Stroke="#94A3B8" StrokeThickness="1.5" />
                            <Line X1="325" Y1="118" X2="325" Y2="154" Stroke="#94A3B8" StrokeThickness="1.5" />
                            <TextBlock Canvas.Left="332" Canvas.Top="56" Text="id_cliente" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Canvas.Left="176" Canvas.Top="78" Text="id_pedido" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Canvas.Left="408" Canvas.Top="60" Text="id_pedido" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Canvas.Left="332" Canvas.Top="124" Text="id_pedido" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />

                            <!-- Tabelas -->
                            <Border Canvas.Left="250" Canvas.Top="10" Width="150" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="cliente" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" />
                            </Border>
                            <Border Canvas.Left="250" Canvas.Top="82" Width="150" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="pedido" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Border Canvas.Left="20" Canvas.Top="82" Width="150" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="pagamento" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" />
                            </Border>
                            <Border Canvas.Left="470" Canvas.Top="82" Width="120" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="entrega" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" />
                            </Border>
                            <Border Canvas.Left="250" Canvas.Top="154" Width="150" Height="36" CornerRadius="8" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                                <TextBlock Text="item_pedido" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" />
                            </Border>
                        </Canvas>
                    </Viewbox>
                </DockPanel>
            </Border>

            <!-- Mudanças entre versões -->
            <Border Style="{StaticResource Card}" Padding="16" Grid.Column="2">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Digest Changes" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Differences between schema versions" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="34" Padding="10,0" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <TextBlock Text="v1.2.0 (Apr 20, 2024)" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="34" Height="34" Margin="8,0" Content="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <Border Grid.Column="2" Height="34" Padding="10,0" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <TextBlock Text="v1.3.0 (Apr 26, 2024)" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="3" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Added" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="1" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Removed" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{StaticResource PurpleSoftBrush}" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PurpleBrush}" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="4" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Modified" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid ItemsSource="{Binding DigestChanges}" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="*" />
                            <DataGridTemplateColumn Header="Change" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Change}" Foreground="{Binding ChangeFg}" FontWeight="Medium" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
