<UserControl x:Class="MockDataStudio.App.Views.SchemaDigestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MockDataStudio.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho e ações -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Schema Digest" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Crie e explore uma representação compacta da estrutura do seu banco de dados."
                           Style="{StaticResource PageSubtitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Projeto" Style="{StaticResource MutedText}" />
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ProjectName}" FontWeight="Medium" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="220" Height="38" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" AutomationProperties.Name="Conexão de origem" />
                <Button Style="{StaticResource PrimaryButton}" Height="38" Margin="10,0,0,0" Padding="14,0" Command="{Binding CaptureCommand}" AutomationProperties.Name="Extrair digest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Extract Digest" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0" Command="{Binding ImportCommand}" AutomationProperties.Name="Importar digest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Import" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Height="38" Margin="10,0,0,0" Command="{Binding ExportCommand}" AutomationProperties.Name="Exportar digest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Export JSON" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="38" Margin="10,0,0,0" Padding="14,0" Cursor="Hand" Background="{StaticResource SuccessSoftBrush}"
                        BorderThickness="0" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"
                        Command="{Binding ValidateCommand}" AutomationProperties.Name="Validar digest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Validate" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Estado e progresso -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ProgressPhase}" Style="{StaticResource MutedText}" />
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Margin="12,0,0,0" Content="Cancelar"
                        Command="{Binding CancelCommand}" AutomationProperties.Name="Cancelar captura" />
            </Grid>
        </Border>

        <!-- Linha superior: estrutura, navegador e JSON -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Estrutura do banco -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Database Structure" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Visão geral dos objetos extraídos" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <ComboBox DockPanel.Dock="Top" Height="34" Margin="0,0,0,12" ItemsSource="{Binding Snapshots}"
                              SelectedItem="{Binding SelectedSnapshot}" AutomationProperties.Name="Snapshot ativo" />

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding DigestStats}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" CornerRadius="10" Padding="10,8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Fg}" />
                                        <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding DigestInfo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Navegador do digest -->
            <Border Style="{StaticResource Card}" Padding="16" Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PurpleSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Digest Browser" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Tabelas e colunas do snapshot" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <controls:SearchField DockPanel.Dock="Top" Placeholder="Buscar tabelas ou colunas..." Margin="0,0,0,10"
                                          Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TreeView x:Name="DigestTreeView" ItemsSource="{Binding DigestTree}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=OneTime}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Prévia JSON -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.Column="4" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,16,12">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource TealSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JSON Preview" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Digest do snapshot selecionado" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBox Style="{StaticResource ReadOnlyEditor}" Text="{Binding DigestJson, Mode=OneWay}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Linha inferior: relacionamentos e mudanças -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- Relacionamentos -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource TealSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Schema Relationships" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Chaves estrangeiras do snapshot" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Relationships}" FontSize="12" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tabela (colunas)" Binding="{Binding From}" Width="*" />
                            <DataGridTextColumn Header="Referencia" Binding="{Binding To}" Width="*" />
                            <DataGridTextColumn Header="Regra" Binding="{Binding Rule}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Mudanças entre versões -->
            <Border Style="{StaticResource Card}" Padding="16" Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Digest Changes" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Height="34" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding CompareFrom}" AutomationProperties.Name="Versão anterior" />
                        <TextBlock Grid.Column="1" Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Margin="8,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" Height="34" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding CompareTo}" AutomationProperties.Name="Versão nova" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Content="Compare Versions"
                                Command="{Binding CompareCommand}" AutomationProperties.Name="Comparar versões" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AddedCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                <TextBlock Text="adicionados" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RemovedCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                <TextBlock Text="removidos" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PurpleSoftBrush}" CornerRadius="10" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ModifiedCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                <TextBlock Text="modificados" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding DigestChanges}" FontSize="12" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severidade" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="Objeto" Binding="{Binding ObjectName}" Width="*" />
                            <DataGridTemplateColumn Header="Mudança" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Change}" Foreground="{Binding ChangeFg}" FontWeight="Medium" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
