<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Tokens de cor (docs/21 §2.1), tema claro.
      Valores = mockups aprovados (regra: divergências entre mockup e documento são resolvidas a favor do mockup, DA-027).
      O tema escuro ainda não é aplicado (pendente; ver docs/21 §2.1).
    -->

    <!-- Superfícies e texto -->
    <Color x:Key="Bg.Base">#FFFFFF</Color>
    <Color x:Key="Bg.Panel">#F3F6FB</Color>
    <Color x:Key="Fg.Primary">#0F172A</Color>
    <Color x:Key="Fg.Muted">#64748B</Color>
    <Color x:Key="Accent">#2563EB</Color>
    <Color x:Key="Border">#E3E8F0</Color>

    <!-- Ambientes (chip/margem). "Test" corresponde ao QA do mockup. -->
    <Color x:Key="Env.Development">#1D4ED8</Color>
    <Color x:Key="Env.Test">#6D28D9</Color>
    <Color x:Key="Env.Staging">#B45309</Color>
    <Color x:Key="Env.Production">#B91C1C</Color>
    <Color x:Key="Env.Unknown">#475569</Color>

    <!-- Severidade (diagnósticos) -->
    <Color x:Key="Sev.Error">#CF222E</Color>
    <Color x:Key="Sev.Warning">#9A6700</Color>
    <Color x:Key="Sev.Info">#0969DA</Color>
    <Color x:Key="Sev.Success">#1A7F37</Color>

    <!-- Confiança de mapeamento (sempre acompanhada de texto/ícone) -->
    <Color x:Key="Conf.High">#15803D</Color>
    <Color x:Key="Conf.Medium">#B45309</Color>
    <Color x:Key="Conf.Low">#B91C1C</Color>
    <Color x:Key="Conf.None">#64748B</Color>

</ResourceDictionary>
