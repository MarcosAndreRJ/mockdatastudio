<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superfícies -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F3F6FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="EditorBrush" Color="#FBFCFE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E8F0" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Destaque e estados -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#EDE9FE" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FFEDD5" />
    <SolidColorBrush x:Key="TealBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="TealSoftBrush" Color="#CFFAFE" />
    <SolidColorBrush x:Key="PinkBrush" Color="#DB2777" />
    <SolidColorBrush x:Key="PinkSoftBrush" Color="#FCE7F3" />

</ResourceDictionary>
