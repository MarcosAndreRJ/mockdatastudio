<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MockDataStudio.Catalog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MockDataStudio.Core\MockDataStudio.Core.csproj" />
    <ProjectReference Include="..\MockDataStudio.SqlTooling\MockDataStudio.SqlTooling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrações imutáveis (09 §3, M-01) e schema de staging (09 §4). -->
    <EmbeddedResource Include="Migrations\*.sql" />
    <EmbeddedResource Include="Staging\staging-schema.sql" />
    <EmbeddedResource Include="Seeds\*.json" />
  </ItemGroup>
</Project>
